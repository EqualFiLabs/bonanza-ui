NEXT_PUBLIC_APP_ENV=development
# Required only when NEXT_PUBLIC_APP_ENV=production.
NEXT_PUBLIC_SITE_URL=

# The shared public EqualFi Privy App ID. Each app keeps its own login session.
NEXT_PUBLIC_PRIVY_APP_ID=
# Optional when the Privy application requires a client ID.
NEXT_PUBLIC_PRIVY_CLIENT_ID=

# robinhood-testnet is the default. anvil is accepted only in development.
NEXT_PUBLIC_APP_NETWORK=robinhood-testnet

# Server-owned browser security policy. Production defaults to report-only when omitted.
BONANZA_CSP_MODE=off
# Match this to the bot-control provider selected in the Privy dashboard.
BONANZA_CSP_CAPTCHA_PROVIDER=none
# Optional custom Privy authentication origin, without a path.
BONANZA_PRIVY_AUTH_ORIGIN=
# Optional release identifier included in redacted CSP violation logs.
BONANZA_RELEASE=

# Server-only upstreams for the same-origin browser read proxy. Never use NEXT_PUBLIC_* here.
BONANZA_ROBINHOOD_TESTNET_RPC_URL=
BONANZA_ROBINHOOD_MAINNET_RPC_URL=
# Server-only upstreams used only by Privy embedded wallets to prepare and broadcast signed
# transactions. Wallet traffic never falls back to the read upstreams.
BONANZA_ROBINHOOD_TESTNET_WALLET_RPC_URL=
BONANZA_ROBINHOOD_MAINNET_WALLET_RPC_URL=

# Local fork only. npm run fork:up needs a Robinhood Chain RPC and a contract checkout.
ROBINHOOD_MAINNET=
BONANZA_CONTRACTS_DIR=../bonanza
