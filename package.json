{
  "name": "bonanza-ui",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@10.9.4",
  "scripts": {
    "dev": "next dev",
    "dev:fork": "node scripts/fork/dev.mjs",
    "fork:build": "node scripts/fork/build.mjs",
    "fork:up": "node scripts/fork/up.mjs",
    "fork:down": "node scripts/fork/down.mjs",
    "fork:reset": "node scripts/fork/reset.mjs",
    "fork:status": "node scripts/fork/status.mjs",
    "config:privy:local": "node scripts/import-local-privy.mjs",
    "abi:sync": "node scripts/sync-abi.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:css": "stylelint \"app/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:fork": "playwright test --config playwright.fork.config.ts",
    "verify": "npm run lint && npm run lint:css && npm run format:check && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@privy-io/react-auth": "3.38.0",
    "@privy-io/wagmi": "4.0.16",
    "@solana-program/memo": "^0.10.0",
    "@solana-program/system": "0.10.0",
    "@solana/web3.js": "^1.99.0",
    "@stripe/stripe-js": "9.14.0",
    "@tanstack/react-query": "5.101.4",
    "buffer": "^6.0.3",
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "viem": "2.55.10",
    "wagmi": "3.7.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "1.61.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.11",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
